{
  "name": "cppclasscreator",
  "displayName": "Simple C++ Class Creator",
  "description": "This is a VS Code extension for creating C++ classes with header and implementation files",
  "publisher": "andrei2699",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrei2699/CPP-Class-Creator-VS-Code-Extension"
  },
  "bugs": {
    "url": "https://github.com/andrei2699/CPP-Class-Creator-VS-Code-Extension/issues"
  },
  "homepage": "https://github.com/andrei2699/CPP-Class-Creator-VS-Code-Extension",
  "license": "Apache-2.0",
  "keywords": [
    "c++",
    "class",
    "creator",
    "generate"
  ],
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:cppclasscreator.createClass"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppclasscreator.createClass",
        "title": "Create C++ Class"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "group": "navigation",
          "command": "cppclasscreator.createClass"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
